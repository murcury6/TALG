# Copy this file to .env and enter API credentials locally.
# Never commit the populated .env file.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Market data only; this project never calls Alpaca order endpoints.
APCA_API_DATA_URL=https://data.alpaca.markets
APCA_API_DATA_FEED=iex

# Native Meta Llama API. Choose a model available to your account.
LLAMA_API_KEY=
LLAMA_MODEL=
LLAMA_CHAT_COMPLETIONS_URL=https://api.llama.com/v1/chat/completions
